----
import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----

async fn check(target : String, arguments : Array[String], expected_code : Int32, expected_verdict : String) -> Unit {
  let argv = ["run", "--target", target, "cmd/check", "--"]
  argv.append(arguments)
  let result = @shell.Cmd("moon", argv).output(timeout_ms=120000)
  if result.exit_code() != expected_code {
    fail("unexpected CLI exit \{result.exit_code()}, expected \{expected_code}; stderr: \{result.stderr()}")
  }
  if expected_verdict != "" {
    let json = @json.parse(result.stdout())
    guard json is { "verdict": String(verdict), .. } && verdict == expected_verdict else {
      fail("incorrect report verdict")
    }
  } else if expected_code == 2 {
    let json = @json.parse(result.stderr())
    guard json is { "error": String(_), .. } else { fail("expected structured input error") }
  }
}

async fn draft_example(target : String) -> Unit {
  let prefix = ["run", "--target", target, "cmd/check", "--", "draft", "synthetic-lazy-service"]
  let first = prefix + ["fixtures/coverage/startup.om", "fixtures/coverage/traffic.om"]
  let second = prefix + ["fixtures/coverage/traffic.om", "fixtures/coverage/startup.om"]
  let a = @shell.Cmd("moon", first).output(timeout_ms=120000)
  let b = @shell.Cmd("moon", second).output(timeout_ms=120000)
  assert_eq(a.exit_code(), 0)
  assert_eq(b.exit_code(), 0)
  assert_eq(a.stdout(), b.stdout())
  let value = @json.parse(a.stdout())
  guard value is { "complete": False, "metrics": Array(metrics), .. } && metrics.length() == 2 else {
    fail("draft must contain two observed schemas and remain explicitly incomplete")
  }
  assert_false(a.stdout().contains("GET"))
}

async fn migration_check(target : String, candidate : String, review : String, code : Int32, status : String) -> Unit {
  let result = @shell.Cmd("moon", ["run", "--target", target, "cmd/check", "--", "assess",
    "fixtures/migration/baseline.json", candidate, review, "--json"]).output(timeout_ms=120000)
  assert_eq(result.exit_code(), code)
  let value = @json.parse(result.stdout())
  guard value is { "review_status": String(actual), "compatibility": { "verdict": String(verdict), .. }, .. } else {
    fail("expected independent review status and compatibility verdict")
  }
  assert_eq(actual, status)
  assert_eq(verdict, "incompatible")
}

async fn migration_template_example(target : String) -> Unit {
  let result = @shell.Cmd("moon", ["run", "--target", target, "cmd/check", "--", "review-template",
    "fixtures/migration/baseline.json", "fixtures/migration/candidate.json"]).output(timeout_ms=120000)
  assert_eq(result.exit_code(), 0)
  let value = @json.parse(result.stdout())
  guard value is { "approvals": Array(entries), "baseline": Object(_), "candidate": Object(_), .. } else { fail("expected bound template") }
  assert_eq(entries.length(), 1)
  guard entries[0] is { "code": String(code), "reviewer": String(reviewer), .. } else { fail("expected unfilled review entry") }
  assert_eq(code, "label-removed")
  assert_eq(reviewer, "")
}

async fn main {
  let target = @env.args().get(1).unwrap_or("wasm")
  let baseline = "fixtures/kubernetes/baseline.json"
  check(target, ["compare", baseline, baseline, "--json"], 0, "compatible")
  check(target, ["compare", baseline, "fixtures/kubernetes/breaking.json", "--json"], 1, "incompatible")
  check(target, ["compare", baseline, "fixtures/kubernetes/partial.json", "--json"], 3, "inconclusive")
  check(target, ["verify", baseline, "fixtures/kubernetes/observation.om", "--json"], 0, "compatible")
  check(target, ["verify", baseline, "fixtures/empty.om", "--json"], 3, "inconclusive")
  check(target, ["verify", baseline, "fixtures/unsupported.om", "--json"], 2, "")
  check(target, ["normalize", "fixtures/invalid.json"], 2, "")
  check(target, ["normalize", "fixtures/not-present.json"], 2, "")
  let coverage = "fixtures/coverage/contract.json"
  let startup = "fixtures/coverage/startup.om"
  let traffic = "fixtures/coverage/traffic.om"
  check(target, ["verify", coverage, startup, "--json"], 3, "inconclusive")
  check(target, ["verify-many", coverage, traffic, startup, "--json"], 0, "compatible")
  check(target, ["verify-many", coverage, startup, "--json"], 3, "inconclusive")
  check(target, ["verify-many", coverage, startup, "fixtures/coverage/mismatch.om", traffic, "--json"], 1, "incompatible")
  check(target, ["verify-many", coverage, startup, startup, "--json"], 2, "")
  check(target, ["verify-many", coverage, startup, "fixtures/unsupported.om", "--json"], 2, "")
  draft_example(target)
  check(target, ["draft", "synthetic-lazy-service", startup, "fixtures/coverage/mismatch.om"], 2, "")
  check(target, ["draft", "synthetic-lazy-service", "fixtures/empty.om"], 2, "")
  check(target, ["draft", "synthetic-lazy-service", startup, "fixtures/unsupported.om"], 2, "")
  check(target, ["verify-many", coverage], 2, "")
  check(target, ["draft", "synthetic-lazy-service"], 2, "")
  migration_template_example(target)
  migration_check(target, "fixtures/migration/candidate.json", "fixtures/migration/approved.json", 0, "ready")
  migration_check(target, "fixtures/migration/candidate.json", "fixtures/migration/pending.json", 1, "needs-review")
  migration_check(target, "fixtures/migration/partial.json", "fixtures/migration/incomplete.json", 3, "inconclusive")
  check(target, ["assess", "fixtures/migration/baseline.json", "fixtures/migration/baseline.json", "fixtures/migration/approved.json", "--json"], 2, "")
  check(target, ["assess", "fixtures/migration/baseline.json", "fixtures/migration/candidate.json", "fixtures/invalid.json", "--json"], 2, "")
  println("27 CLI scenarios passed on \{target}")
}
